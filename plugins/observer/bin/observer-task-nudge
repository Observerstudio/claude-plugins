#!/usr/bin/env bash
#
# "You just filed work — file the task." A PostToolUse hook.
#
# Fires after a Bash call whose command created a GitHub issue or PR
# (`gh issue create`, `gh pr create`). It does one thing: hand the agent the
# URL it just produced and tell it to file (or link) the Observer task NOW,
# in the same turn, before it moves on.
#
# WHY POST, NOT PRE. The task needs the issue URL, and it should exist only
# for issues that actually landed — a PreToolUse hook has neither, and a
# failed `gh issue create` would leave a task pointing at nothing.
#
# WHY A NUDGE, NOT A BLOCK. A hook cannot know whether a matching task
# already exists (the agent may be about to link one, or may have filed it a
# minute ago). Blocking on a fact the hook cannot see is how a hook gets
# uninstalled by the first person it inconveniences.
#
# Read-only. Never fails the tool call: every path exits 0.

set -uo pipefail

input="$(cat)"
[ -n "$input" ] || exit 0

python3 - "$input" <<'PY'
import json, re, sys

try:
    data = json.loads(sys.argv[1])
except Exception:
    sys.exit(0)

if data.get("tool_name") != "Bash":
    sys.exit(0)

command = (data.get("tool_input") or {}).get("command", "") or ""
kind = None
if re.search(r"\bgh\s+issue\s+create\b", command):
    kind = "issue"
elif re.search(r"\bgh\s+pr\s+create\b", command):
    kind = "pull request"
if kind is None:
    sys.exit(0)

response = data.get("tool_response")
if isinstance(response, dict):
    text = " ".join(str(v) for v in response.values())
else:
    text = str(response or "")

match = re.search(r"https://github\.com/[\w.-]+/[\w.-]+/(?:issues|pull)/\d+", text)
if not match:
    # The call did not print a URL — most likely it failed. Nothing to file.
    sys.exit(0)
url = match.group(0)

message = (
    f"observer: you just filed the GitHub {kind} {url}. "
    "File the matching Observer task NOW, in this turn, before anything else: "
    "`create_task` with the project from `project_for_repo` (git remote), title = the outcome "
    "(not the activity), description = that link plus the one-line context. "
    "If a task for this work already exists, link it instead with `push_task_to_github` / "
    "`sync_task_to_github`. Every new piece of work has an Observer task the moment it exists — "
    "GitHub alone is invisible to the people reading the board."
)

print(json.dumps({
    "hookSpecificOutput": {
        "hookEventName": "PostToolUse",
        "additionalContext": message,
    }
}))
PY
exit 0
